    {
      "id": "l_a0_003",
      "level": "A0",
      "topicId": "t_a0_courtesy",
      "titleEs": "Un móvil en el suelo",
      "titleUk": "Мобільний телефон на землі",
      "kind": "dialogue",
      "orderIndex": 3,
      "lines": [
        { "speaker": "A", "spanish": "¡Perdón! ¿Es tu móvil?", "translationUk": "Перепрошую! Це твій телефон?" },
        { "speaker": "B", "spanish": "¡Sí! Muchas gracias.", "translationUk": "Так! Щиро дякую." },
        { "speaker": "A", "spanish": "De nada. No pasa nada.", "translationUk": "Нема за що. Нічого страшного." },
        { "speaker": "B", "spanish": "Qué amable. Gracias.", "translationUk": "Як люб’язно. Дякую." },
        { "speaker": "A", "spanish": "¿Necesitas más ayuda?", "translationUk": "Тобі потрібна ще допомога?" },
        { "speaker": "B", "spanish": "No, gracias. ¡Adiós!", "translationUk": "Ні, дякую. Бувай!" },
        { "speaker": "A", "spanish": "¡Adiós! ¡Hasta pronto!", "translationUk": "Бувай! До скорої зустрічі!" }
      ],
      "keyWords": [
        { "spanish": "perdón", "translationUk": "перепрошую" },
        { "spanish": "el móvil", "translationUk": "мобільний телефон" },
        { "spanish": "muchas gracias", "translationUk": "щиро дякую" },
        { "spanish": "de nada", "translationUk": "нема за що" },
        { "spanish": "no pasa nada", "translationUk": "нічого страшного" },
        { "spanish": "amable", "translationUk": "люб’язний" },
        { "spanish": "la ayuda", "translationUk": "допомога" }
      ],
      "comprehensionQuestions": [
        {
          "questionUk": "Що знайшов A?",
          "options": ["Un móvil", "Un libro", "Una llave"],
          "correctIndex": 0,
          "explanationUk": "A питає «¿Es tu móvil?» — отже, він знайшов телефон."
        },
        {
          "questionUk": "Як B дякує?",
          "options": ["Dice «De nada»", "Dice «Muchas gracias»", "Dice «Lo siento»"],
          "correctIndex": 1,
          "explanationUk": "B каже «¡Sí! Muchas gracias», а «De nada» відповідає вже A."
        },
        {
          "questionUk": "Чи потрібна B ще якась допомога?",
          "options": ["Sí, necesita mucha ayuda", "No lo sabe", "No, no necesita ayuda"],
          "correctIndex": 2,
          "explanationUk": "B відповідає «No, gracias» — допомога більше не потрібна."
        }
      ]
    },
