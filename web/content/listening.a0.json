        { "spanish": "igualmente", "translationUk": "взаємно" },
        { "spanish": "hablamos luego", "translationUk": "поговоримо пізніше" }
      ],
      "comprehensionQuestions": [
        {
          "questionUk": "Як звати чоловіка?",
          "options": ["Pablo", "Ana", "Madrid"],
          "correctIndex": 0,
          "explanationUk": "Він представляється: «Yo soy Pablo»."
        },
        {
          "questionUk": "Звідки Пабло?",
          "options": ["De Ucrania", "De Madrid", "De Barcelona"],
          "correctIndex": 1,
          "explanationUk": "Пабло каже «Yo soy de Madrid», а Ана — «Soy de Ucrania»."
        },
        {
          "questionUk": "Що відповідає Пабло на «Mucho gusto»?",
          "options": ["Hasta luego", "No, gracias", "Igualmente"],
