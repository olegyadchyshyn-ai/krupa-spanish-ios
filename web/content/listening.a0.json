    {
      "id": "l_a0_001",
      "level": "A0",
      "topicId": "t_a0_greetings",
      "titleEs": "En la calle",
      "titleUk": "На вулиці",
      "kind": "dialogue",
      "orderIndex": 1,
      "lines": [
        { "speaker": "A", "spanish": "¡Hola! ¿Qué tal?", "translationUk": "Привіт! Як справи?" },
        { "speaker": "B", "spanish": "Muy bien, gracias.", "translationUk": "Дуже добре, дякую." },
        { "speaker": "A", "spanish": "¿Y tú? ¿Todo bien?", "translationUk": "А ти? Усе гаразд?" },
        { "speaker": "B", "spanish": "Sí, todo muy bien.", "translationUk": "Так, усе дуже добре." },
        { "speaker": "A", "spanish": "¡Qué alegría verte!", "translationUk": "Як я рада тебе бачити!" },
        { "speaker": "B", "spanish": "¡Hasta luego, Ana!", "translationUk": "Бувай, Ано!" }
      ],
      "keyWords": [
        { "spanish": "hola", "translationUk": "привіт" },
        { "spanish": "¿Qué tal?", "translationUk": "Як справи?" },
        { "spanish": "muy bien", "translationUk": "дуже добре" },
        { "spanish": "gracias", "translationUk": "дякую" },
        { "spanish": "todo bien", "translationUk": "усе гаразд" },
        { "spanish": "hasta luego", "translationUk": "до побачення" }
      ],
      "comprehensionQuestions": [
        {
          "questionUk": "Як відповідає B на вітання?",
          "options": ["Muy bien, gracias", "Muy mal, gracias", "No lo sé"],
          "correctIndex": 0,
          "explanationUk": "B каже «Muy bien, gracias», тобто «Дуже добре, дякую»."
        },
        {
          "questionUk": "Як B прощається?",
          "options": ["Buenos días", "Hasta luego", "Buenas noches"],
          "correctIndex": 1,
          "explanationUk": "B каже «¡Hasta luego, Ana!» — це прощання, а не вітання."
        },
        {
          "questionUk": "Як звати дівчину, до якої звертається B?",
          "options": ["Marta", "Lucía", "Ana"],
          "correctIndex": 2,
          "explanationUk": "B називає її на ім’я: «¡Hasta luego, Ana!»"
        }
      ]
    },
    {
